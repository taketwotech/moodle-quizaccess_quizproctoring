{{!
    @template quizaccess_quizproctoring/quiz_loading

    Full-page loading indicator for in-shell quiz navigations.
    Uses core/loading so themes that override that template (e.g. RemUI) keep their spinner.

    Example context (json):
    {}
}}
<div class="proctorlink-quiz-loading-inner d-flex flex-column align-items-center justify-content-center">
    {{> core/loading }}
    <span class="visually-hidden sr-only">{{#str}} loadinghelp, core {{/str}}</span>
</div>
